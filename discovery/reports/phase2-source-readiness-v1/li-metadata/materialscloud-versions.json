 "role": {"id": "contactperson", "title": {"de": "Kontaktperson", "en": "Contact person"}}, "affiliations": [{"name": "University of Idaho, Department of Nuclear Engineering and Industrial Management, Idaho Falls, ID 83402, United States"}]}, {"person_or_org": {"type": "personal", "name": "Xu, Fei", "given_name": "Fei", "family_name": "Xu"}, "role": {"id": "contactperson", "title": {"de": "Kontaktperson", "en": "Contact person"}}, "affiliations": [{"name": "Idaho National Laboratory, 1955 Fremont Ave, Idaho Falls, ID 83415, United States"}]}], "languages": [{"id": "eng", "title": {"en": "English"}}], "related_identifiers": [{"identifier": "https://github.com/avakanski/Subsized-Specimens-Tensile-Properties", "scheme": "url", "relation_type": {"id": "issupplementto", "title": {"en": "Is supplement to"}}, "resource_type": {"id": "other", "title": {"de": "Sonstige", "en": "Other"}}}], "sizes": ["184130"], "formats": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/markdown"], "rights": [{"id": "cc-by-4.0", "title": {"en": "Creative Commons Attribution 4.0 International"}, "description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "props": {"url": "https://creativecommons.org/licenses/by/4.0/legalcode", "scheme": "spdx"}}], "description": "The dataset provides records of tensile properties of nuclear structural materials. The focus is on studying the influence of specimen dimensions and geometry on mechanical properties such as yield strength, ultimate tensile strength, uniform elongation, and total elongation. The dataset was created through an extensive literature review of scientific articles and databases. The search inclusion criteria targeted peer-reviewed studies on tensile testing of sub-sized specimens, providing quantitative data on tensile properties relative to specimen size. The extracted data points from the literature review were organized into a tabular format database containing 1,070 tensile testing records with 54 parameters, including material type and composition, manufacturing information, irradiation conditions, specimen size and dimensions, and tensile properties. Materials science experts conducted systematic checks to validate the collected data, ensuring accuracy in the material type, manufacturing processes and treatment methods, and testing conditions, as well as verifying the chemical composition and other pertinent information. Our team performed statistical analyses to identify and address data outliers, ensuring the reliability of the dataset."}, "custom_fields": {"mc_references": [{"ref_resource_type": "website", "ref_citation": "https://github.com/avakanski/Subsized-Specimens-Tensile-Properties", "ref_link": {"ref_scheme": "url", "ref_identifier": "https://github.com/avakanski/Subsized-Specimens-Tensile-Properties"}, "ref_comment": "The paper has been submitted for potential publication in Scientific Data. If the paper is accepted for publication, we will update the reference."}]}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 2, "total_bytes": 184130, "entries": {"Tensile_Properties_of_Sub-sized_Specimens.xlsx": {"id": "b7743ed4-0d28-4f55-ab74-6d85981537d7", "checksum": "md5:041bbe095c54615e5a3c289facb18ce5", "ext": "xlsx", "size": 183878, "mimetype": "application/octet-stream", "key": "Tensile_Properties_of_Sub-sized_Specimens.xlsx", "metadata": {}, "access": {"hidden": false}}, "files_description.md": {"id": "a62d1940-9b33-4bf6-b680-6c6464c8efbc", "checksum": "md5:de38aa9b2c53c044fd83fe7bfe4c4d5a", "ext": "md", "size": 252, "mimetype": "application/octet-stream", "key": "files_description.md", "metadata": {}, "access": {"hidden": false}}}}, "media_files": {"enabled": false, "order": [], "count": 0, "total_bytes