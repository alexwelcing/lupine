+    const scaledD = shift >= 0 ? d : d * 10n ** BigInt(-shift);
+    let rounded = scaledN / scaledD;
+    if (2n * (scaledN % scaledD) >= scaledD) rounded += 1n;
+    if (rounded === 10000n) { rounded = 1000n; exponent += 1; }
