+    if (n === 0n) return '0';
+    let exponent = numerator.length - value.denominator.length;
+    if (exponent >= 0 ? n < d * 10n ** BigInt(exponent) : n * 10n ** BigInt(-exponent) < d) exponent -= 1;
+    const shift = 3 - exponent;
