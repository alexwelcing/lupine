  "ribbon_version": "hyperribbon-mptrj-state-phase-v5",
  "checkpoint_contract": {
    "scope": "raw_predictions",
    "baseline_mode": "read-write",
    "distill_accuracy_mode": "read-only",
    "pairing_rule": "baseline and Distill Accuracy for the same row and MLIP must share one checkpoint URL"
  },
  "budget": {
    "max_dollars_per_hour": 10.0,
    "max_active_gpu_jobs": 2,
    "l4_lab_hourly_estimate_usd": 1.05
  },
  "promotion_canary": {
    "required_before_full_launch": true,
    "rows": [
      "energy_volume",
      "forces",
      "relaxation_stability"
    ],
    "mlips": [
      "mace-mp-0",
      "chgnet",
      "orb-v3",
      "sevennet"
    ],
    "gate": {
      "max_regressed_pairs": 0,
      "min_improved_pairs": 1,
      "require_state_condition_coverage_score": 1.0,
      "require_phase_label_count_at_least": 1,
      "required_evaluators": [
        "mlip.state_condition.coverage",
        "mlip.phase_change.phase_labels"
      ],
      "required_zero_regression_rows": [
        "energy_volume",
        "forces",
        "relaxation_stability"
      ]
    },
    "reason": "The canary is deliberately small but includes the forces row because the live 2026-05-31 CHGNet check proved the code path and exposed the fixture-label gap there."
  },
  "rows": [
    "energy_volume",
    "forces",
    "stress",
    "elastic_constants",
    "relaxation_stability"
  ],
  "variants": [
    {
      "variant_id": "baseline",
      "distill_profile": "off",
      "checkpoint_mode": "read-write"
    },
    {
      "variant_id": "distill_accuracy",
      "distill_profile": "accuracy",
      "checkpoint_mode": "read-only"
    }
  ],
  "mlips": [
    {
      "mlip_id": "mace-mp-0",
      "enabled": true
    },
    {
      "mlip_id": "chgnet",
      "enabled": true
    },
    {
      "mlip_id": "m3gnet",
      "enabled": false,
      "blocked_reason": "Hold until the GCP MatGL/DGL image passes a fresh import canary on this runner tag."
    },
    {
      "mlip_id": "orb-v3",
      "enabled": true
    },
    {
      "mlip_id": "sevennet",
      "enabled": true
    },
    {
      "mlip_id": "uma-s-1p1",
      "enabled": false,
      "blocked_reason": "FAIR Chemistry UMA access is gated until the account is authorized for the model repository."
    }
  ],
  "evidence_fields": [
    "source_packet_hash",
    "fixture_manifest_hash",
    "support_manifest_hash",
    "backend_catalog_hash",
    "policy_registry_hash",
    "distill_policy_hash",
    "shared_checkpoint_url",
    "baseline_cell_id",
    "distill_accuracy_cell_id",
    "artifact_uri",
    "cloud_run_operation_name",
    "phoenix_trace_id",
    "thermodynamic_condition_coverage",
    "state_condition_coverage_score",
    "phase_labels"
  ],
  "acceptance_gate": {
    "ready_to_launch": [
      "source packet validates",
      "sealed fixture validates",
      "support manifest is present locally and has a GCS target",
      "every enabled MLIP maps to an allowlisted Cloud Run target job",
      "every Distill lane resolves hyperribbon-mptrj-state-phase-v5-accuracy.json",
      "all Distill cells depend on the paired baseline checkpoint",
      "glim-think /research/workflows lists mlip.state_condition.coverage and mlip.phase_change.phase_labels"
    ],
    "ready_to_claim_state_phase_gain": [
      "Phoenix evaluator mlip.state_condition.coverage reports score 1 for each canary row",
      "Phoenix evaluator mlip.phase_change.phase_labels reports score 1 for each canary row",
      "runner artifacts preserve pressure_count, temperature_count, phase_count, and phases",
      "paired Distill Accuracy cells show zero regressions against the shared baseline checkpoints"
    ],
    "known_blocker": [
      "canonical-structures-v2 currently has no pressure/temperature/phase labels, so the first run is expected to surface missing_state_condition and missing_phase_labels until a labeled fixture replaces it"
    ]
  }
