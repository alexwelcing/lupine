# MLIP runner images need the canonical Rust Distill policy binary and the
# Python runtime package at Cloud Build time. Keep the rest of the ignored
# monorepo surface out of upload context.
atlas-distill/**
!atlas-distill/
!atlas-distill/Cargo.toml
!atlas-distill/Cargo.lock
!atlas-distill/src/
!atlas-distill/src/**
lupine-distill/**
!lupine-distill/
!lupine-distill/runtime/
!lupine-distill/runtime/python/
!lupine-distill/runtime/python/lupine_distill_runtime/
!lupine-distill/runtime/python/lupine_distill_runtime/**

